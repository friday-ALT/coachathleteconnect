# ==================================
# SUPABASE CONFIGURATION
# ==================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Supabase Project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (public - safe to use in client)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (secret - server only, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connection String (from Supabase Dashboard > Settings > Database)
# Use "Connection pooling" mode for better performance
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ==================================
# APPLICATION CONFIGURATION
# ==================================

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-session-secret-here-change-in-production

# Email Configuration (Resend API for transactional emails)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Server Configuration
PORT=3000
NODE_ENV=development

# Public URL of the web app (Stripe redirect after checkout / Connect)
WEB_APP_URL=http://localhost:3000

# ==================================
# STRIPE (required for paid bookings + coach payouts)
# ==================================
# Test keys: https://dashboard.stripe.com/test/apikeys
# Webhook endpoint: https://YOUR-API-DOMAIN/api/payments/webhook
# Events: checkout.session.completed, charge.refunded
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ==================================
# OPTIONAL: Replit Auth (Legacy)
# ==================================
# Only needed if keeping Replit authentication alongside Supabase
REPLIT_DOMAINS=
REPL_ID=
ISSUER_URL=https://replit.com/oidc
