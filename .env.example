# ==================================
# SUPABASE CONFIGURATION
# ==================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Secret — server only, never commit or expose to clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (Supabase Dashboard > Settings > Database > Connection pooling)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ==================================
# APPLICATION CONFIGURATION
# ==================================

# Required in all environments. Generate: openssl rand -base64 32
# Rotate in production if leaked; invalidates all JWT sessions.
SESSION_SECRET=your-session-secret-here-change-in-production

RESEND_API_KEY=re_xxxxxxxxxxxxx

# Dev API listens on 5000 by default (mobile resolves Metro host:5000)
PORT=5000
NODE_ENV=development

# Public web URL (Stripe redirects, email links, CORS in production)
WEB_APP_URL=http://localhost:5173

# Comma-separated allowed browser origins (production). Defaults to WEB_APP_URL.
# CORS_ORIGINS=https://coachathleteconnect-production.up.railway.app

# Demo login is disabled in production unless explicitly enabled
# ENABLE_DEMO_AUTH=true

# ==================================
# GOOGLE OAUTH (web + mobile)
# ==================================
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Mobile (set in EAS env or mobile/app.json extra):
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ==================================
# APPLE SIGN IN (mobile)
# ==================================
# APPLE_CLIENT_ID=com.coachathleteconnect

# ==================================
# STRIPE (paid bookings + coach payouts)
# ==================================
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ==================================
# OPTIONAL: Replit Auth (Legacy)
# ==================================
REPLIT_DOMAINS=
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# ==================================
# SECRETS HYGIENE
# ==================================
# - Never commit .env (listed in .gitignore)
# - Rotate SESSION_SECRET, STRIPE keys, and DB password if exposed
# - Use Railway/hosting env vars for production, not local .env
